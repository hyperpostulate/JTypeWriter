<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.mesutormanli</groupId>
    <artifactId>jtypewriter</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>JTypeWriter</name>
    <description>A distraction-free text editor</description>
    <url>https://github.com/hyperpostulate/JTypeWriter</url>

    <organization>
        <name>Mesut ORMANLI</name>
        <url>https://github.com/hyperpostulate</url>
    </organization>

    <!--
        Declared here as well as in the artifacts so `mvn help:effective-pom`
        answers "what is this under" without opening the jar, and so Maven
        Central-style tooling and SBOM generators can read the license without
        guessing. The bundled OpenJDK runtime and JavaFX stay GPLv2 + Classpath
        Exception; see NOTICE.
    -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>hyperpostulate</id>
            <name>Mesut ORMANLI</name>
            <email>mesutormanli@gmail.com</email>
            <url>https://github.com/hyperpostulate</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/hyperpostulate/JTypeWriter.git</connection>
        <developerConnection>scm:git:git@github.com:hyperpostulate/JTypeWriter.git</developerConnection>
        <url>https://github.com/hyperpostulate/JTypeWriter</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            Reproducible builds: archive entries take this fixed epoch instead of
            the wall clock at build time, so the same source and toolchain
            produce identical timestamps. Bumped only with a release, never per
            commit.
        -->
        <project.build.outputTimestamp>2026-10-25T00:00:00Z</project.build.outputTimestamp>
        <javafx.version>26.0.1</javafx.version>
        <junit.version>6.0.3</junit.version>
        <mockito.version>5.23.0</mockito.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Fail at `validate` - before a single class is compiled - when the
                build runs on a JDK or Maven that cannot produce this project.
                Without this the first honest signal is a compiler error about
                `release 25` or a plugin demanding a newer Maven, which says
                nothing about what the user should install.

                The JDK floor is derived from ${java.version}, the same property
                the compiler uses, so raising the language level cannot leave the
                check behind. Maven 3.8 is the floor documented in both READMEs.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-build-toolchain</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                    <message>JTypeWriter needs JDK ${java.version} or newer (maven.compiler.release is ${java.version}); point JAVA_HOME at a JDK ${java.version} installation and run the build again</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.8,)</version>
                                    <message>JTypeWriter needs Maven 3.8 or newer; upgrade Maven (the POM pins every plugin version, so no wrapper is shipped)</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.mesutormanli.jtypewriter.JTypeWriterApp</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!--
                A plain JAR can only carry its license as a resource, so LICENSE,
                NOTICE and the third-party notices are copied into
                target/classes/META-INF during process-resources. The license texts
                they reference travel with them under META-INF/licenses/, because a
                fat jar that names a GPL component without carrying that component's
                license text is a broken distribution, not a complete one. The
                maven-assembly-plugin packs that same class directory into the fat
                jar, so this single copy covers both artifacts.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>copy-license</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}</directory>
                                    <includes>
                                        <include>LICENSE</include>
                                        <include>NOTICE</include>
                                        <include>THIRD-PARTY-NOTICES</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/legal</directory>
                                    <targetPath>licenses</targetPath>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Single runnable JAR with JavaFX on the classpath (the entry point
                is deliberately not an Application subclass, see JTypeWriterApp).
                This is the artifact jpackage wraps into native app images; it is
                produced by every `mvn package` so a release is always
                reproducible from source.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.mesutormanli.jtypewriter.JTypeWriterApp</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>make-fat-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>org.mesutormanli.jtypewriter.JTypeWriterApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>